 <main role="main">
      <section class="jumbotron text-center">
        <div class="container">
          <h1 class="jumbotron-heading mt-2">Blackjack</h1>
          <p class="lead text-muted">Dealer Score: <%= @game.dealer_score %></p>
          <p class="lead text-body-tertiary">You Score: <%= @game.hand.summed_score %></p>
          <p>
            <a href="#" class="btn btn-primary my-2">Hit Me</a>
            <a href="#" class="btn btn-secondary my-2">I'll Stay</a>
          </p>
        </div>
      </section>

      <div class="album py-5 bg-light">
        <div class="container">
          <div class="row">
            <% @game.hand.cards.each do |card|  %>
              <div class="col-md-4">
                  <div class="card mb-4 box-shadow">
                    <div class="card-body">
                      <p class="card-text"><%= card.rank %></p>
                      <p class="card-text"><%= card.value %></p>
                      <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                          <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                          <button type="button" class="btn btn-sm btn-outline-secondary">Edit</button>
                        </div>
                        <small class="text-muted">9 mins</small>
                      </div>
                    </div>
                  </div>
              </div>
            <% end%>
          </div>
        </div>
      </div>
    </main>