    <section class="jumbotron text-center">
      <div class="container">
        <h1 class="jumbotron-heading mt-2">Blackjack</h1>
        <p class="lead text-muted">Dealer Score: <%= @game.dealer_score %></p>
        <p class="lead text-body-tertiary">You Score: <%= @game.player_hand.summed_score %></p>
        <div class="d-flex gap-2 justify-content-center align-items-center">
          <%= button_to "Hit", play_game_path(@game),
            method: :get,
            params: { hit: true },
            data: { turbo: false },
            class: "btn btn-primary my-2" %>

          <%= button_to "I'll Stay", play_game_path(@game),
            method: :get,
            params: { stay: true },
            class: "btn btn-secondary my-2" %>

          <%= button_to "Start Over", "/",
            method: :get,
            class: "btn btn-outline-danger my-2" %>
        </div>





      </div>
    </section>