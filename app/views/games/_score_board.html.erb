    <section class="jumbotron text-center">
      <div class="container">
        <h1 class="jumbotron-heading mt-2 mb-2">
          <% if @game.winner == 'player' %>
            <span class="text-success">You Win ◝(ᵔᗜᵔ)◜</span>
          <% elsif @game.winner == 'dealer' %>
            <span class="text-danger">You Lose (˃̣̣̥ᯅ˂̣̣̥)</span>
          <% elsif @game.winner == 'tie' %>
            <span class="text-secondary">You Tie (・―・)</span>
          <% end %>
        </h1>
        <p class="lead text-white">
          Dealer Score: <%= @game.dealer_hand.calculated_score(face_up_only: true) %>
        </p>
        <p class="lead text-white">You Score: <%= @game.player_hand.calculated_score %></p>

      </div>
    </section>