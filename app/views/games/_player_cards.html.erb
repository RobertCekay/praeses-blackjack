<div class="album py-2">
    <div class="container">
      <h2 class="mt-2 text-white">Your Cards</h2>

      <div class="row justify-content-center">
        <% @game.player_hand.cards.each do |card| %>
          <%= render "card", card: card %>
        <% end %>
      </div>

      <div class='row '>
        <div class="d-flex justify-content-center gap-2 ">
        <div>
        <%= button_to "Hit Me!", play_game_path(@game),
            method: :get,
            params: { hit: true },
            data: { turbo: false },
            class: "btn btn-primary my-2" %>
        </div>


          <%= button_to "I'll Stay", play_game_path(@game),
            method: :get,
            params: { stay: true },
            class: "btn btn-secondary my-2" %>

          <%= button_to "Start Over", "/",
            method: :get,
            class: "btn btn-outline-danger my-2" %>
        </div>
      </div>

    </div>
  </div>