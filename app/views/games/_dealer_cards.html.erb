<div class="album py-2">
      <div class="container ">
        <h2 class="mt-2 text-white">Dealer's Cards</h2>
        <div class="mt-2 text-white row justify-content-center">
          <% @game.dealer_hand.cards.each do |card|  %>
            <% if !card.facedown %>
              <%= render "card", card: card %>
            <% else %>
              <div class="col-md-2">
                <div class="card mb-4 box-shadow dealer-card">
                  <div class="card-body">
                    <p class="card-text">Face</p>
                    <p class="card-text">Down</p>
                    <p class="card-text">Card</p>
                  </div>
                </div>
              </div>
            <% end %>
          <% end%>
        </div>
      </div>
    </div>