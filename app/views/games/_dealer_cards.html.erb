<div class="album py-2 bg-light">
      <div class="container ">
        <h2 class="mt-2">Dealer's Cards</h2>
        <div class="mt-2 row justify-content-center">
          <% @game.dealer_hand.cards.each do |card|  %>
            <div class="col-md-2">
                <% if !card.facedown %>
                  <div class="card mb-4 box-shadow player-card <%= card_color_class(card) %>">
                    <div class="card-body">
                      <p class="card-text dealer-card-info"><%= card.rank %> of <%= card.suit_symbol %></p>
                      <p class="card-text"><%= card.color %></p>
                    </div>
                  </div>
                <% else %>
                  <div class="card mb-4 box-shadow dealer-card">
                    <div class="card-body">
                      <p class="card-text">Face</p>
                      <p class="card-text">Down</p>
                      <p class="card-text">Card</p>
                    </div>
                  </div>
                <% end %>
            </div>
          <% end%>
        </div>
      </div>
    </div>